{
  "name": "@backinit/native",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "npm:react-native-tvos@0.87-stable",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@react-native-tvos/config-tv": "^0.1.7",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:mobile": "expo start --dev-client",
    "start:tv": "EXPO_TV=1 expo start --dev-client",
    "prebuild:mobile": "expo prebuild --clean --platform android",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean --platform android",
    "android:mobile": "expo run:android",
    "android:tv": "EXPO_TV=1 expo run:android",
    "build:mobile:apk": "eas build --platform android --profile mobile-apk --local",
    "build:tv:apk": "eas build --platform android --profile tv-apk --local",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor"
  },
  "private": true,
  "expo": { "install": { "exclude": ["react-native"] } }
}
