{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "env": {
    "API_BACKEND": "external",
    "API_URL": "https://backinit-api.onrender.com",
    "ALLOW_DEMO_MODE": "false",
    "SPORTS_DATA_MODE": "real"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
