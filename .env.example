# Local pnpm dev. Public frontend configuration in vercel.json uses Render.
API_URL=http://127.0.0.1:4000
# Set API_BACKEND=external with API_URL for a separately hosted backend.
# Vercel requires HTTPS for an external backend. Never use NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL is only for installations using a private service binding.
PORT=4000
WEB_ORIGIN=http://127.0.0.1:3000
APP_ORIGIN=http://127.0.0.1:3000
SPORTS_DATA_MODE=real
# Keep false on public installations. True is only for isolated demo/CI testing.
ALLOW_DEMO_MODE=false
# API reads exported variables; use an absolute persistent path outside tests.
# DATABASE_PATH=/absolute/path/backinit.sqlite
# Enable only with applicable business feed permission.
BBC_FEED_LICENSED=false

# Reviewed exact public hostnames only, comma-separated; no wildcards or IPs.
# These permissions do not grant broadcast rights. API process reads these.
STREAM_ALLOWED_HOSTS=
STREAM_EMBED_HOSTS=

# Disable auxiliary public team-identity catalogues independently of fixture data.
TEAM_METADATA_DISABLED=false

# Backend only. Free YouTube Data API v3 metadata; never expose as NEXT_PUBLIC_*.
# Restrict the key to YouTube Data API v3 in Google Cloud. Leave empty for public-page fallback.
YOUTUBE_API_KEY=

# Optional licensed Sportradar LMT pilot. Empty means no Sportradar requests.
# Use BackInIt's own Client ID and match IDs supplied by its licensed coverage.
# Client ID is public widget configuration; never put an API key here.
SPORTRADAR_CLIENT_ID=
# JSON array: eventId, matchId (sr:match:...), sport, home, away, start (ISO UTC).
# Mappings are exact and must be renewed if the fixture start or participants change.
SPORTRADAR_TRACKER_MATCHES=
